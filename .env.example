LLM_PROVIDER=auto                       # auto (Claude if a key is set) | anthropic | ollama (free, local)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5        # fast and cheap; overridable
OLLAMA_BASE_URL=http://localhost:11434  # used when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b                 # run `ollama pull qwen2.5:3b` first
LLM_TIMEOUT_MS=8000                     # use ~30000 with Ollama: the first call loads the model
FORCE_LLM_FAILURE=false                 # demo switch: forces the fallback path
RATE_LIMIT_PER_MIN=20
API_PORT=4000
WEB_PORT=3000                           # change if 3000 is taken; npm run dev uses it
