{
  "name": "crystal-ball-approvals-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Approvals AI assistant panel: Next.js web + Express API + shared Zod contracts.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test -w @approvals/api",
    "test:web": "npm run test -w @approvals/web",
    "coverage": "npm run coverage -w @approvals/api && npm run coverage -w @approvals/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
